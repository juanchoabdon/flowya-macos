{
  "name": "flowya",
  "version": "1.0.59",
  "description": "A floating macOS productivity app with glassmorphism UI",
  "main": "dist-electron/electron/main.js",
  "author": "Flowya",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --mac",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && npx electron .\"",
    "release": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.34.0",
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "electron-liquid-glass": "^1.1.1",
    "electron-updater": "^6.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": "electron-builder.json"
  }
}
